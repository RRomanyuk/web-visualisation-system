# Скопіюйте у backend/.env та за потреби змініть значення

# Файл БД SQLite (відносно робочої директорії запуску)
DATABASE_URL=sqlite:///./data/app.db

# CORS: дозволені origin клієнта (через кому)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Необов'язковий allowlist хостів для отримання даних із зовнішніх API.
# Порожнє значення = дозволені будь-які хости (лише для локального прототипу).
ALLOWED_SOURCE_HOSTS=

# Таймаут запиту до зовнішнього API, секунд
SOURCE_FETCH_TIMEOUT=30

# Максимальний розмір відповіді зовнішнього API, МБ
SOURCE_MAX_RESPONSE_MB=50

# Максимальна кількість рядків у наборі
SOURCE_MAX_ROWS=200000
